{
  "name": "portfolio",
  "version": "0.0.1",
  "scripts": {
    "prepare": "husky",
    "build": "next build",
    "prod": "docker build -t dev-portfolio-next . && docker run -p 4000:80 -t dev-portfolio-next",
    "postbuild": "next-sitemap",
    "start": "next dev",
    "build-stats": "cross-env ANALYZE=true bun run build",
    "export": "next export",
    "lint-check:react": "cross-env NODE_ENV=production && eslint src --no-fix --max-warnings=0",
    "lint-check:typing": "tsc --noEmit",
    "lint-check:prettier": "prettier --check src",
    "lint-fix:react": "cross-env NODE_ENV=production && eslint src --max-warnings=0 --fix",
    "lint-fix:prettier": "prettier --write src"
  },
  "browser": {
    "fs": false,
    "path": false
  },
  "targets": {
    "developmentBuild": {
      "distDir": "build",
      "scopeHoist": false
    },
    "productionBuild": {
      "distDir": "build",
      "sourceMap": false,
      "scopeHoist": false
    }
  },
  "dependencies": {
    "@next/third-parties": "^16.2.7",
    "anylogger": "^1.0.11",
    "axios": "^1.17.0",
    "date-fns": "^4.4.0",
    "i18n-iso-countries": "^7.14.0",
    "i18next": "^26.3.1",
    "lenis": "^1.3.23",
    "mime": "^4.1.0",
    "next": "^16.2.7",
    "next-i18next": "^16.0.7",
    "next-sitemap": "^4.2.3",
    "path-to-regexp": "^8.4.2",
    "query-string": "^9.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-schemaorg": "^2.0.1",
    "react-social-icons": "^6.26.0",
    "react-toast-notifications": "^2.5.1",
    "sass": "^1.100.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "ulog": "^2.0.0-beta.19"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@next/bundle-analyzer": "^16.2.7",
    "@next/eslint-plugin-next": "^16.2.7",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/content-disposition": "^0.5.9",
    "@types/mime": "^4.0.0",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/react-infinite-calendar": "^2.3.9",
    "@types/react-is": "^19.2.0",
    "@types/react-onclickoutside": "^6.7.10",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "commitizen": "^4.3.1",
    "cross-env": "^10.1.0",
    "cssnano": "^8.0.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.4.1",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-react-app": "^7.0.1",
    "eslint-plugin-i18next": "^6.1.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.0",
    "typescript": "^6.0.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "license": "MIT"
}
